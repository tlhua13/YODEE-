<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_lead_form_inherit" model="ir.ui.view">
            <field name="name">crm.lead.form.inherit.condition</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header/field[@name='stage_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//group[@name='opportunity_partner']/label[@for='email_from']"
                       position="before">
                    <field name="sale_area_id"/>
                    <field name="name_wholesaler" readonly="1"/>
                    <field name="sale_admin_id" />
                    <field name="sale_manager_id" />
                </xpath>


            </field>
        </record>

        <record id="crm_opportunity_kanban_readonly_stage" model="ir.ui.view">
            <field name="name">crm.opportunity.kanban.readonly.stage</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban/field[@name='stage_id']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>

            </field>
        </record>


 <record id="crm.menu_crm_lead_stage_act" model="ir.ui.menu">
    <field name="groups_id" eval="[(6, 0, [
        ref('base.group_system'),
        ref('sales_team.group_sale_manager')
    ])]"/>
</record>






    </data>
</odoo>
