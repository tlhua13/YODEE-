<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_team_form_inherit" model="ir.ui.view">
            <field name="name">crm.team.form.inherit.condition</field>
            <field name="model">crm.team</field>
            <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
            <field name="arch" type="xml">
            <xpath expr="//group[@name='left']/field[@name='user_id']" position="after">
                <field name="sale_admin_id"/>
            </xpath>
            <xpath expr="//group[@name='left']/field[@name='user_id']" position="before">
                <field name="sale_area_id" widget="many2many_tags"/>
            </xpath>
            </field>
        </record>
    </data>
</odoo>
