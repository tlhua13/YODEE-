<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
     <record id="product_pricelist_view_inherit_sale_team" model="ir.ui.view">
            <field name="name">product.pricelist.form.inherit.sale.team</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="sale_team_ids"/>
                </xpath>

            </field>
     </record>

        <record id="product_pricelist_tree_inherit_sale_team" model="ir.ui.view">
            <field name="name">product.pricelist.tree.inherit.sale.team</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="sale_team_ids"  widget="many2many_tags"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
