<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_momo_qr" model="report.paperformat">
            <field name="name">MoMo QR Code</field>
            <field name="format">custom</field>
            <field name="page_width">60</field>
            <field name="page_height">110</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="orientation">Portrait</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_momo_qr" model="ir.actions.report">
            <field name="name">MoMo QR Code</field>
            <field name="model">momo.transaction</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">advanced_momo.report_momo_qr</field>
            <field name="report_file">advanced_momo.report_momo_qr</field>
            <field name="print_report_name">'MoMo_QR_%s' % object.name</field>
            <field name="binding_model_id" ref="model_momo_transaction"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_momo_qr"/>
        </record>
    </data>
</odoo>
