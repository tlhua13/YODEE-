<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_pos_order_form_inherit_momo" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.momo</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']" position="inside">
                <field name="momo_order_id" invisible="not momo_order_id"/>
            </xpath>
        </field>
    </record>

</odoo>
