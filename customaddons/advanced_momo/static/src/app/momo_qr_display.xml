<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="advanced_momo.MomoQRDisplay">
        <div class="momo-qr-display d-flex flex-column align-items-center p-3 rounded-3 border border-2 mb-2"
             style="border-color: #a50064 !important; background: #fff;">

            <!-- Waiting State: Show QR -->
            <t t-if="state.status === 'waiting'">
                <div class="d-flex justify-content-center mb-3">
                    <img src="/advanced_momo/static/src/img/momo_logo.png" style="width: 230px; height: 67px;"/>
                    </div>
                <div class="d-flex justify-content-center mb-3">
                    <div style="border: 3px solid #a50064; border-radius: 12px; padding: 12px; background: white;">
                        <img t-att-src="momoData.qrCodeUrl" alt="MoMo QR Code"
                             style="width: 200px; height: 200px;"/>
                    </div>
                </div>
                <div class="text-muted mb-2">
                        <p class="mb-2" style="font-size: 16px; text-align: center;">
                            Sử dụng <span style="font-weight: bold;">App Momo</span> hoặc <span style="font-weight: bold;">Ứng dụng Ngân hàng</span> để quét mã
                    </p>
                    </div>
                <div class="mb-2 fs-4 fw-bold" style="color: #a50064;">
                    <t t-esc="formattedAmount"/>
                </div>
                <div t-if="momoData.orderId" class="text-muted mb-1" style="font-size: 13px;">
                    Order ID: <strong t-esc="momoData.orderId"/>
                </div>
                <div class="text-muted mb-2">
                    <i class="fa fa-spinner fa-spin me-1"/>
                    <t t-esc="state.message"/>
                </div>
                <div class="text-muted mb-2" style="font-size: 13px;">
                    Time remaining: <strong t-esc="formattedCountdown"/>
                </div>
                <div class="d-flex gap-2 mt-3 w-100 justify-content-center">
                    <button class="btn btn-outline-secondary" t-on-click="onPrintQR">
                        <i class="fa fa-print me-1"/> Print QR
                    </button>
                    <button class="btn btn-primary" t-on-click="onForceDone">
                        <i class="fa fa-check me-1"/> Force Done
                    </button>
                    <button class="btn btn-secondary" t-on-click="onCancel">
                        <i class="fa fa-times me-1"/> Cancel
                    </button>
                </div>
            </t>

            <!-- Success State -->
            <t t-if="state.status === 'success'">
                <div class="text-center py-3">
                    <i class="fa fa-check-circle text-success" style="font-size: 56px;"/>
                    <h4 class="mt-2 text-success">Payment Successful!</h4>
                    <div class="fs-5 fw-bold" style="color: #a50064;">
                        <t t-esc="formattedAmount"/>
                    </div>
                </div>
            </t>

            <!-- Failed State -->
            <t t-if="state.status === 'failed'">
                <div class="text-center py-3">
                    <i class="fa fa-times-circle text-danger" style="font-size: 56px;"/>
                    <h4 class="mt-2 text-danger">Payment Failed</h4>
                    <p class="text-muted mb-1">
                        <t t-esc="state.message"/>
                    </p>
                    <div class="d-flex gap-2 mt-2 justify-content-center">
                        <button class="btn btn-primary btn-sm" t-on-click="onRetry">
                            <i class="fa fa-refresh me-1"/> Retry
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="onCancel">
                            Close
                        </button>
                    </div>
                </div>
            </t>

            <!-- Timeout State -->
            <t t-if="state.status === 'timeout'">
                <div class="text-center py-3">
                    <i class="fa fa-clock-o text-warning" style="font-size: 56px;"/>
                    <h4 class="mt-2 text-warning">Payment Timed Out</h4>
                    <p class="text-muted">
                        <t t-esc="state.message"/>
                    </p>
                    <div class="d-flex gap-2 mt-2 justify-content-center">
                        <button class="btn btn-primary btn-sm" t-on-click="onRetry">
                            <i class="fa fa-refresh me-1"/> Retry
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="onCancel">
                            Close
                        </button>
                    </div>
                </div>
            </t>

        </div>
    </t>

</templates>
