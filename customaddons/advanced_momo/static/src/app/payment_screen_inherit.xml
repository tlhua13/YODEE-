<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">

        <!-- Desktop: insert MomoQRDisplay before PaymentScreenStatus inside .payment-summary -->
        <xpath expr="//div[hasclass('payment-summary')]/PaymentScreenStatus" position="before">
            <MomoQRDisplay t-if="pos.momoQrData"/>
        </xpath>

        <!-- Mobile: insert MomoQRDisplay before PaymentScreenStatus in mobile layout -->
        <xpath expr="//div[hasclass('d-flex','flex-grow-1','flex-column','overflow-y-auto','gap-1')]/PaymentScreenStatus" position="before">
            <MomoQRDisplay t-if="pos.momoQrData"/>
        </xpath>

    </t>

    <t t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('electronic_status')][normalize-space(text())='Request sent']/following-sibling::div" position="replace">
            <div class="button send_payment_request highlight text-bg-primary"
                 title="Retry Payment" t-on-click="() => this.props.sendPaymentCancel(line)">
                Retry
            </div>
        </xpath>
        <xpath expr="//div[hasclass('electronic_status')][normalize-space(text())='Request sent']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </t>

</templates>
