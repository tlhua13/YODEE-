<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_category_misa_form_view" model="ir.ui.view">
            <field name="name">product_category_misa.form_view</field>
            <field name="model">product.category.misa</field>
            <field name="arch" type="xml">
                <form string="product_category_misa">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" required="1"/>
                            </group>
                            <group>
                                <field name="code_list"/>
                                <field name="misa_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_category_misa_list_view" model="ir.ui.view">
            <field name="name">product_category_misa.list</field>
            <field name="model">product.category.misa</field>
            <field name="arch" type="xml">
                <list string="product_category_misa">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="product_category_misa_search_view" model="ir.ui.view">
            <field name="name">product_category_misa_search_view.search</field>
            <field name="model">product.category.misa</field>
            <field name="arch" type="xml">
                <search string="product_category_misa">
                    <group expand="1">
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="product_category_misa_act_window" model="ir.actions.act_window">
            <field name="name">Product Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.category.misa</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="advanced_sync_misa_product_category_misa_menu"
                  name="Product Category" sequence="20"
                  parent="advanced_sync_misa.advanced_account_misa_dictionary_menu"
                  action="product_category_misa_act_window"/>

    </data>
</odoo>