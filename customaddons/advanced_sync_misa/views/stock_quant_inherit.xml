<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="advanced_sync_misa_view_stock_quant_list_inventory_editable" model="ir.ui.view">
            <field name="name">advanced_sync_misa.view_stock_quant_list_inventory_editable</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="create_audit_misa" display="always" type="object" class="btn-primary" data-hotkey="q" string="Đồng bộ về Misa"/>
                </xpath>
                <xpath expr="//field[@name='quantity']" position="after" >
                    <field name="currency_id" column_invisible="True"/>
                    <field name="value" widget="monetary" optional="show" sum="Tổng giá trị" options="{'currency_field': 'currency_id'}"/>
                    <field name="quantity_misa" groups="base.group_no_one" optional="hide"/>
                    <field name="value_stock_misa" groups="base.group_no_one" optional="hide" sum="value"/>
                </xpath>
                   <xpath expr="//field[@name='quantity']" position="attributes">
                    <attribute name="sum">Tổng</attribute>
                </xpath>
                 <xpath expr="//field[@name='inventory_quantity']" position="attributes">
                    <attribute name="sum">Tổng đếm</attribute>
                </xpath>
            </field>
        </record>

        <record id="advanced_sync_misa_view_stock_quant_list" model="ir.ui.view">
            <field name="name">advanced_sync_misa.stock.view_stock_quant_tree_inventory_editable</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                        <attribute name="confirm">Cần đồng bộ MISA trước khi áp dụng tồn kho!</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>