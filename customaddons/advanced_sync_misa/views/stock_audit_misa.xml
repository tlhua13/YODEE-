        <record id="stock_audit_misa_view_list" model="ir.ui.view">
            <field name="name">stock_audit_misa.view_list</field>
            <field name="model">stock.audit.misa</field>
            <field name="arch" type="xml">
                <list string="stock_audit_misa_list" create="0" edit="0">
                    <field name="no"/>
                    <field name="location_id" required="1" force_save="1"/>
                    <field name="ref_date"/>
                    <field name="misa_status"/>
                </list>
            </field>
        </record>


        <record id="action_stock_audit_misa" model="ir.actions.act_window">
            <field name="name">Sync Misa</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.audit.misa</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="stock_audit_misa_form_view"/>
            <field name="target">new</field>
        </record>
        <record id="action_stock_audit_misa_full" model="ir.actions.act_window">
            <field name="name">Stock Audit(Misa)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.audit.misa</field>
            <field name="context">{'create': False, 'edit': False}</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_stock_audit_misa"
                  name="Stock Audit(Misa)"
                  action="action_stock_audit_misa_full"
                  parent="stock.menu_warehouse_report"
                  sequence="1000"/>
