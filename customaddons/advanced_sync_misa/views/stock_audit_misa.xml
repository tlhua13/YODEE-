        <record id="stock_audit_misa_form_view" model="ir.ui.view">
            <field name="name">stock_audit_misa_form_view</field>
            <field name="model">stock.audit.misa</field>
            <field name="arch" type="xml">
                <form string="Sync Misa">
                    <div class="oe_title">
                        <h1>
                            <field name="no" readonly="misa_status != 'not_synced'"/>
                        </h1>

                        <field name="misa_status" invisible="1"/>
                        <field name="finish_sync_misa" invisible="1"/>

                        <h2 style="color:#4d4d4d!important;text-align:left"
                            invisible="id == False or misa_status != 'not_synced'">
                            Misa: Unsynchronized
                            <field name="noti_status_misa"/>
                        </h2>

                        <h2 style="color:green!important;text-align:left"
                            invisible="id == False or misa_status != 'synced'">
                            Misa: Synchronized
                            <field name="noti_status_misa"/>
                        </h2>

                        <h2 style="color:red!important;text-align:left"
                            invisible="id == False or misa_status != 'sync_failed'">
                            Misa: Synchronization Failed
                            <field name="noti_status_misa"/>
                        </h2>
                    </div>

                    <group>
                        <group>
                            <field name="location_id"
                                   force_save="1"
                                   readonly="misa_status != 'not_synced'"/>

                            <field name="employee_ids"
                                   widget="many2many_tags"
                                   readonly="misa_status != 'not_synced'"/>

                            <field name="about" readonly="misa_status != 'not_synced'"/>
                        </group>

                        <group>
                            <field name="audit_date"
                                   required="1"
                                   readonly="misa_status != 'not_synced'"/>

                            <field name="no"
                                   required="1"
                                   readonly="misa_status != 'not_synced'"/>

                            <field name="ref_date"
                                   required="1"
                                   readonly="misa_status != 'not_synced'"/>
                        </group>

