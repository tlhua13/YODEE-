                        <field name="stock_quant_sync" nolabel="1" force_save="1" readonly="1">
                            <list limit="20" default_order="location_id product_id">
                                <field name="location_id"/>
                                <field name="product_id"/>
                                <field name="lot_id" optional="hiden"/>
                                <field name="quantity_on_book" sum="sum1"/>
                                <field name="quantity_audit"  sum="sum2"/>
                                <field name="diff_quantity"
                                       decoration-muted="diff_quantity == 0"
                                       decoration-danger="diff_quantity &lt; 0"
                                       decoration-success="diff_quantity &gt; 0"
                                       decoration-bf="diff_quantity != 0"/>
                                <field name="value_stock_misa"  sum="sum3"/>
                            </list>
                        </field>
                    </group>

                    <footer>
                        <button name="sync_misa_stock_picking_in_audit"
                                string="Sync Misa"
                                type="object"
                                class="btn-primary"
                                invisible="misa_status == 'synced'"/>

                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
