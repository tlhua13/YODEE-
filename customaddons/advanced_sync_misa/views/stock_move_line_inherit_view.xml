<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--        inherit stock move line list view-->
        <record id="stock_move_line_list_inherit_view" model="ir.ui.view">
            <field name="name">stock.move.line.list.inherit.view</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='reference']" position="after">
                    <field name="origin"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>