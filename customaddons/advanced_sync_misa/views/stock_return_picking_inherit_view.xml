<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--        inherit stock move line list view-->
    <record id="view_stock_return_picking_form_inherit_custom" model="ir.ui.view">
    <field name="name">stock.return.picking.form.inherit.custom</field>
    <field name="model">stock.return.picking</field>
    <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='product_return_moves']/list/field[@name='product_id']" position="after">
            <field name="product_status" optional="show"/>
        </xpath>

    </field>
</record>




    </data>
</odoo>