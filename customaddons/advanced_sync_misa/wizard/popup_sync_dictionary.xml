<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="popup_sync_dictionary_view_form" model="ir.ui.view">
            <field name="name">popup_sync_dictionary.view_form</field>
            <field name="model">popup.sync.dictionary</field>
            <field name="arch" type="xml">
                <form string="popup_sync_dictionary_form">
                    <sheet>
                        <group>
                            <group>
                                <field name="data_type" invisible="is_syn_inventory_balance"/>
                                <field name="location_id" invisible="not is_syn_inventory_balance"/>
                                <field name="skip" invisible="1"/>
                            </group>

                            <group>
                                <field name="last_sync_time"/>
                                <field name="limit"/>
                                <field name="is_syn_inventory_balance"/>
                            </group>
                        </group>

                        <footer>
                            <button name="sync_misa_get_dictionary"
                                    string="Submit"
                                    type="object"
                                    class="btn btn-primary"
                                    invisible="is_syn_inventory_balance"/>

                            <button name="sync_misa_get_list_inventory_balance"
                                    string="Syn Inventory Balance"
                                    type="object"
                                    class="btn btn-primary"
                                    invisible="not is_syn_inventory_balance"/>

                            <button string="Cancel"
                                    class="btn btn-secondary"
                                    special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="popup_sync_dictionary_action" model="ir.actions.act_window">
            <field name="name">Fetch Data Misa</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">popup.sync.dictionary</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="popup_sync_dictionary_menu"
                  name="Fetch Data"
                  parent="advanced_sync_misa.advanced_account_misa_root"
                  action="popup_sync_dictionary_action"
                  sequence="10"/>
    </data>
</odoo>