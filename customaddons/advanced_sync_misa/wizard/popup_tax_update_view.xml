<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_wizard_popup_action_tax_update" model="ir.actions.server">
            <field name="name"># Tax Update</field>
            <field name="state">code</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="binding_model_id" ref="model_product_template"/>
            <field name="binding_view_types">list</field>
            <field name="code">action = records.sudo().action_tax_update()</field>
        </record>
    <record id="popup_tax_update_view_form" model="ir.ui.view">
        <field name="name">popup_tax_update_view</field>
        <field name="model">popup.tax.update</field>
        <field name="arch" type="xml">
            <form string="Tax Update">
                <group>
                    <field name="update_option" required="1"/>
                    <field name="tax_id" domain="[('id', 'in', valid_tax_ids)]"/>
                    <field name="valid_tax_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="action_update" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
