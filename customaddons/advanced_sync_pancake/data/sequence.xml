<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sequence_yodee_log" model="ir.sequence">
            <field name="name">Sequence yodee LOG</field>
            <field name="code">yodee.log</field>
            <field name="prefix">LOG/%(year)s/</field>
            <field name="padding">11</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_sale_order_b2b" model="ir.sequence">
            <field name="name">Sale Order B2B</field>
            <field name="code">sale.order.b2b</field>

            <field name="prefix">B2B</field>
            <field name="suffix">-%(month)s%(year)s</field>

            <field name="padding">4</field>
            <field name="number_next">1</field>

            <field name="use_date_range">True</field>
        </record>

    </data>
</odoo>