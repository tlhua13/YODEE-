<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <data>
        <record id="ir_cron_get_customer_from_pancake" model="ir.cron">
            <field name="name">#Pancake: Get customer from Pancake</field>
            <field name="model_id" ref="advanced_sync_pancake.model_pancake_connector"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_customer_from_pancake()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="priority" eval="6"/>
        </record>

        <record id="ir_cron_get_product_from_pancake" model="ir.cron">
            <field name="name"># Pancake: Get product from Pancake</field>
            <field name="model_id" ref="advanced_sync_pancake.model_pancake_connector"/>
            <field name="state">code</field>
            <field name="code">model.get_product_list()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="priority" eval="6"/>
        </record>

        <record id="ir_cron_get_order_from_pancake" model="ir.cron">
            <field name="name"># Pancake: Get Order from Pancake</field>
            <field name="model_id" ref="advanced_sync_pancake.model_pancake_connector"/>
            <field name="state">code</field>
            <field name="code">model.get_order_list()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="priority" eval="6"/>
        </record>

        <record id="ir_cron_pancake_sync_stock" model="ir.cron">
            <field name="name">#Pancake: Sync Stock</field>
            <field name="model_id" ref="model_pancake_connector"/>
            <field name="state">code</field>
            <field name="code">model.action_sync_stock()</field>
            <field name="active" eval="False"/>
            <field name="interval_type" >minutes</field>
            <field name="interval_number">10</field>
        </record>

        <record id="ir_cron_process_pancake_order_webhook" model="ir.cron">
            <field name="name">#Pancake: Process Order Webhook</field>
            <field name="model_id" ref="model_pancake_connector"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_pancake_order_webhook()</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="priority" eval="6"/>
        </record>
    </data>
</odoo>
