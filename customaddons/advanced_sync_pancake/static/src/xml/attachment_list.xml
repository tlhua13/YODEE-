<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail.AttachmentList" t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-AttachmentCard-unlink')]" position="after">
            <button t-if="!attachment.isViewable"
                    class="o-mail-AttachmentCard-open btn top-0 justify-content-center align-items-center d-flex w-100 h-100 rounded-0 border-0"
                    t-attf-class="{{ env.inComposer ? 'o-inComposer position-absolute btn-primary transition-base' : 'bg-300' }}"
                    t-on-click.stop="() => this.yodeeFileOpen(attachment)" title="Open">
                <i class="fa fa-folder-open" role="img" aria-label="Open"/>
            </button>
        </xpath>
    </t>

</templates>
