<odoo>
    <record id="view_yodee_ir_logging_tree" model="ir.ui.view">
        <field name="name">yodee.ir.logging.tree</field>
        <field name="model">yodee.ir.logging</field>
        <field name="arch" type="xml">
            <list string="Yodee Logs" create="false" delete="false">
                <field name="create_date"/>
                <field name="name"/>
                <field name="message"/>
                <field name="json_data"/>
            </list>
        </field>
    </record>

    <record id="view_yodee_ir_logging_form" model="ir.ui.view">
        <field name="name">yodee.ir.logging.form</field>
        <field name="model">yodee.ir.logging</field>
        <field name="arch" type="xml">
            <form string="Yodee Log">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="message" nolabel="1"/>
                        <field name="json_filename" readonly="1"/>
                        <field name="json_data" filename="json_filename" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_yodee_ir_logging" model="ir.actions.act_window">
        <field name="name">Yodee Logs</field>
        <field name="res_model">yodee.ir.logging</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_yodee_ir_logging"
              name="Yodee Logging"
              parent="base.menu_administration"
              action="action_yodee_ir_logging"/>
</odoo>
