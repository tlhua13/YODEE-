<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="pancake_districts_list_view" model="ir.ui.view">
            <field name="name">pancake.districts.list</field>
            <field name="model">pancake.districts</field>
            <field name="arch" type="xml">
                <list string="Pancake districts" create="0">
                    <field name="name"/>
                    <field name="api_district_id"/>
                    <field name="api_province_id"/>
                    <field name="postcode"/>
                </list>
            </field>
        </record>

        <record id="pancake_districts_form_view" model="ir.ui.view">
            <field name="name">pancake.districts.form</field>
            <field name="model">pancake.districts</field>
            <field name="arch" type="xml">
                <form string="Pancake districts" create="0" edit="0">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="postcode"/>
                            <field name="name_en"/>
                            <field name="region_type"/>
                            <field name="api_district_id"/>
                            <field name="api_province_id"/>
                        </group>
                        <group>
                            <field name="pancake_provinces_id"/>
                            <field name="pancake_communes_ids" readonly="1"/>
                            <field name="is_new_district"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_pancake_districts" model="ir.actions.act_window">
            <field name="name">Pancake Districts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pancake.districts</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="pancake_districts_menu_root"
                name="Pancake Districts"
                action="action_open_pancake_districts"
                parent="advanced_sync_pancake.pancake_customer_menu_root"
                sequence="20"/>
        <menuitem
                id="pancake_districts_menu_contact"
                name="Quận huyện(Pancake)"
                action="action_open_pancake_districts"
                parent="contacts.menu_localisation"
                sequence="20"/>
    </data>
</odoo>