        <!--        Mass action -->
        <record id="model_sale_order_mass_action_get_order_by_id" model="ir.actions.server">
            <field name="name">Get pancake order id</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">action = records.mass_action_get_pancake_order_id()</field>
        </record>
        <record id="action_open_pancake_connector" model="ir.actions.server">
            <field name="name">Pancake Connector</field>
            <field name="state">code</field>
            <field name="model_id" ref="model_pancake_connector"/>
            <field name="code">action = model.action_open_pancake_connector()</field>
        </record>


        <menuitem
