        <record id="pancake_connector_form_view" model="ir.ui.view">
            <field name="name">pancake.connector.form</field>
            <field name="model">pancake.connector</field>
            <field name="arch" type="xml">
                <form string="Pancake Connector">
                    <sheet>
                        <group>
                            <field name="pancake_url"/>
                            <field name="pancake_api_key"/>
                            <field name="shop_id"/>
                        </group>
                        <group>
                            <button string="Test Connection" type="object" name="get_info_pancake"
                                    class="oe_highlight"/>
                        </group>
                        <notebook>
                            <page name="pancake_address" string="Address Pancake">
                                <group name="pancake_address_group">
                                    <field name="param_is_new"/>
                                    <field name="pancake_url_province"/>
                                    <field name="params_province_id"/>
                                    <field name="pancake_url_districts"/>
                                    <field name="pancake_url_communes"/>
                                    <field name="params_district_id"/>
                                    <field name="limit_max"/>
                                    <field name="limit_min"/>
                                </group>
                                <separator string="Actions" colspan="2"/>
                                <div>
                                    <button name="get_address_from_pancake"
                                            string="Get Address Pancake"
                                            type="object"
                                            invisible="1"
                                            class="btn btn-primary oe_highlight"/>
                                    <button name="button_get_province_from_pancake"
                                            string="Get Province Pancake"
                                            type="object"
                                            class="btn btn-success"/>

                                    <button name="button_get_districts_from_pancake"
                                            string="Get Districts Pancake"
                                            type="object"
                                            class="btn btn-info"/>

                                    <button name="button_get_communes_from_pancake"
                                            string="Get Communes Pancake"
                                            type="object"
                                            class="btn btn-secondary"/>
                                    <button name="button_get_new_communes_from_pancake"
                                            string="Get New Communes Pancake"
                                            type="object"
                                            class="btn btn-primary oe_highlight"/>
                                </div>
                            </page>
                            <page name="pancake_order" string="Order Pancake">
                                <group name="pancake_order_group">
                                    <field name="order_date_from"/>
                                    <field name="order_date_to"/>
                                    <field name="order_time"/>
                                    <field name="order_duration"/>
                                    <field name="order_page_size"/>
                                    <field name="order_page"/>
<!--                                    <field name="list_status"/>-->
                                    <field name="timeout_minutes_order"/>
                                    <field name="order_break_day"/>
                                </group>
                                <separator string="Actions" colspan="2"/>
                                <div>
                                    <button name="get_order_list"
                                            string="Get Orders List"
                                            type="object"
                                            class="btn btn-primary oe_highlight"/>
                                </div>
                            </page>
                            <page name="pancake_product" string="Product Pancake">
                                <group name="pancake_product_group">
                                    <field name="product_date_from"/>
                                    <field name="product_date_to"/>
                                    <field name="product_time"/>
                                    <field name="product_duration"/>
                                    <field name="product_page_size"/>
                                    <field name="product_page"/>
                                    <field name="timeout_minutes_product"/>
                                </group>
                                <separator string="Actions" colspan="2"/>
                                <div>
                                    <button name="get_product_list"
                                            string="Get Products List"
                                            type="object"
                                            class="btn btn-primary oe_highlight"/>
                                </div>
                            </page>
