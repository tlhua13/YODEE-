<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="pancake_shop_form_view" model="ir.ui.view">
            <field name="name">advanced_sync_pancake.pancake_shop.form</field>
            <field name="model">pancake.shop</field>
            <field name="arch" type="xml">
                <form string="pancake_shop">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Tên sản phẩm"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="shop_id" readonly="1"/>
                                <field name="currency_text"/>
                            </group>
                            <group>
                                <field name="avatar_url"/>
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="pancake_shop_tree_view" model="ir.ui.view">
            <field name="name">advanced_sync_pancake.pancake_shop.tree</field>
            <field name="model">pancake.shop</field>
            <field name="arch" type="xml">
                <list string="pancake_shop">
                    <field name="shop_id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="pancake_shop_act_window" model="ir.actions.act_window">
            <field name="name">Pancake Shop</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pancake.shop</field>
            <field name="view_mode">list,form</field>
        </record>

<!--        <menuitem name="Pancake Shop"-->
<!--          id="pancake_shop_menu"-->
<!--          parent="sale.menu_sale_config"-->
<!--          action="pancake_shop_act_window"-->
<!--          sequence="11"/>-->

    </data>
</odoo>