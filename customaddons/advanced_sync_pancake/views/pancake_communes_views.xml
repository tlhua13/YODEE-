<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="pancake_communes_list_view" model="ir.ui.view">
            <field name="name">pancake.communes.list</field>
            <field name="model">pancake.communes</field>
            <field name="arch" type="xml">
                <list string="Pancake Communes" create="0" edit="0">
                    <field name="name"/>
                    <field name="api_district_id"/>
                    <field name="api_province_id"/>
                    <field name="api_communes_id"/>
                    <field name="postcode"/>
                    <field name="name_en"/>
                    <field name="new_id"/>
                    <field name="region_type"/>
                </list>
            </field>
        </record>

        <record id="pancake_communes_form_view" model="ir.ui.view">
            <field name="name">pancake.communes.form</field>
            <field name="model">pancake.communes</field>
            <field name="arch" type="xml">
                <form string="Pancake Communes" create="0" edit="0">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="postcode"/>
                            <field name="api_province_id"/>
                            <field name="api_communes_id"/>
                            <field name="is_communes_new"/>
                        </group>
                        <group>
                            <field name="postcode"/>
                            <field name="name_en"/>
                            <field name="new_id"/>
                            <field name="region_type"/>
                            <field name="pancake_district_id"/>
                            <field name="pancake_provinces_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_open_pancake_communes" model="ir.actions.act_window">
            <field name="name">Pancake Communes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pancake.communes</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem
                id="pancake_communes_menu_root"
                name="Pancake Communes"
                action="action_open_pancake_communes"
                parent="advanced_sync_pancake.pancake_customer_menu_root"
                sequence="30"/>
        <menuitem
                id="pancake_communes_menu_contact"
                name="Phường Xã(Pancake)"
                action="action_open_pancake_communes"
                parent="contacts.menu_localisation"
                sequence="30"/>
    </data>
</odoo>