<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="pancake_product_template_form_view" model="ir.ui.view">
            <field name="name">advanced_sync_pancake.pancake_product_template.form</field>
            <field name="model">pancake.product.template</field>
            <field name="arch" type="xml">
                <form string="pancake_product_template">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Tên sản phẩm"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="default_code"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                        <group>
                            <field name="product_template_ids">
                                <list>
                                    <field name="default_code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="pancake_product_template_tree_view" model="ir.ui.view">
            <field name="name">advanced_sync_pancake.pancake_product_template.tree</field>
            <field name="model">pancake.product.template</field>
            <field name="arch" type="xml">
                <list string="pancake_product_template">
                    <field name="default_code"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="pancake_product_template_search_view" model="ir.ui.view">
            <field name="name">advanced_sync_pancake.pancake_product_template.search</field>
            <field name="model">pancake.product.template</field>
            <field name="arch" type="xml">
                <search string="pancake_product_template">
                    <group expand="1" string="Group By">
                        <filter string="Mã sản phẩm" name="default_code_domain" domain="[]"
                                context="{'group_by':'default_code'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="pancake_product_template_act_window" model="ir.actions.act_window">
            <field name="name">Sản phẩm mẫu </field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pancake.product.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Sản phẩm mẫu"
          id="pancake_product_template_menu"
          parent="sale.product_menu_catalog"
          action="pancake_product_template_act_window"
          sequence="5"/>

    </data>
</odoo>