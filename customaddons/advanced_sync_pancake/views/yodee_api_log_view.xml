<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="api_log_views_tree" model="ir.ui.view">
            <field name="name">api_log_views_tree</field>
            <field name="model">yodee.ir.logging</field>
            <field name="arch" type="xml">
                <list string="API Log" default_order="name desc" create="0" edit="0" decoration-danger="response_status &gt;= 400" decoration-success="response_status &lt; 400">
                    <field name="create_date"/>
                    <field name="name" width="180px"/>
                    <field name="request_method" optional="show"/>
                    <field name="request_url" optional="show"/>
                    <field name="response_status" optional="show"/>
<!--                    <field name="request_header" optional="hide"/>-->
<!--                    <field name="request_body" optional="hide"/>-->
<!--                    <field name="response_header" optional="hide"/>-->
<!--                    <field name="response_cookies" optional="hide"/>-->
<!--                    <field name="response_body" optional="hide"/>-->
<!--                    <field name="python_exception" optional="hide"/>-->
<!--                    <field name="python_traceback" optional="hide"/>-->
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="api_log_form_tree">
            <field name="name">API Log</field>
            <field name="model">yodee.ir.logging</field>
            <field name="arch" type="xml">
                <form create="0" edit="0">
                    <sheet>
                        <group>
                            <field name="curl" widget="CopyClipboardChar"/>\
                            <field name="create_date"/>
                            <field name="name" readonly="1"/>
                            <br/>
                            <br/>
                            <field name="request_url"/>
                            <field name="request_method"/>
                            <field name="token"/>
                            <field name="request_header"/>
                            <field name="request_cookies"/>
                            <field name="request_body_formated"/>
                            <field name="response_status"/>
                            <field name="response_header"/>
                            <field name="response_cookies"/>
                            <field name="response_body_formated"/>
                            <field name="python_exception"/>
                            <field name="python_traceback"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="api_log_filter" model="ir.ui.view">
            <field name="name">api.log.seach</field>
            <field name="model">yodee.ir.logging</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="request_body"/>
                    <field name="response_body"/>
                    <filter string="Recent" name="create_date" domain="[('create_date', '>=', (datetime.datetime.now() + datetime.timedelta(days=-7)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                    <separator/>
                    <group>
                        <filter string="Response Status" name="response_status" domain="[]" context="{'group_by': 'response_status'}"/>
                        <filter string="Request Method" name="request_method" domain="[]" context="{'group_by': 'request_method'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="incoming_api_log_action" model="ir.actions.act_window">
            <field name="name">Import API Log</field>
            <field name="res_model">yodee.ir.logging</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'import')]</field>
            <field name="search_view_id" ref="api_log_filter"/>
            <field name="context">{'search_default_create_date': True}</field>
        </record>

        <record id="outgoing_api_log_action" model="ir.actions.act_window">
            <field name="name">Export API Log</field>
            <field name="res_model">yodee.ir.logging</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'export')]</field>
            <field name="search_view_id" ref="api_log_filter"/>
            <field name="context">{'search_default_create_date': True}</field>
        </record>

        <record id="pancake_api_call_log_action" model="ir.actions.act_window">
            <field name="name">Yodee API Call Log</field>
            <field name="res_model">yodee.ir.logging</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('source', '=', 'pancake')]</field>
            <field name="search_view_id" ref="api_log_filter"/>
            <field name="context">{'search_default_create_date': True}</field>
        </record>

        <menuitem parent="base.menu_administration" id="api_log_menu" name="Logging" sequence="999"/>
        <menuitem parent="advanced_sync_pancake.api_log_menu" id="api_log_menu_import" name="Import API Log"
                  action="incoming_api_log_action" sequence="10"/>
        <menuitem parent="advanced_sync_pancake.api_log_menu" id="api_log_menu_export" name="Export API Log"
                  action="outgoing_api_log_action" sequence="20"/>
        <menuitem parent="advanced_sync_pancake.api_log_menu" id="api_log_menu_yodee" name="Pancake API Call Log"
                  action="pancake_api_call_log_action" sequence="30"/>
        <menuitem parent="advanced_sync_pancake.api_log_menu" id="exception_log" name="Exception Log"
                  action="base.ir_logging_all_act" sequence="40"/>

    </data>
</odoo>