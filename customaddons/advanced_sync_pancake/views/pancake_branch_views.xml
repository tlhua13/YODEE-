<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="view_pancake_branch_form" model="ir.ui.view">
            <field name="name">pancake.branch.form</field>
            <field name="model">pancake.branch</field>
            <field name="arch" type="xml">
                <form string="Pancake Branch">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="pancake_supplier_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Pancake Sync">
                                <group string="Pancake Sync" groups="base.group_no_one">
                                    <field name="pancake_order_json" invisible="1"/>
                                    <field name="pancake_order_json_text" widget="text" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pancake_branch_tree" model="ir.ui.view">
            <field name="name">pancake.branch.tree</field>
            <field name="model">pancake.branch</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <!--                    <field name="pancake_supplier_id"/>-->
                </list>
            </field>
        </record>

        <record id="action_pancake_branch" model="ir.actions.act_window">
            <field name="name">Brand</field>
            <field name="res_model">pancake.branch</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Brand"
                  id="pancake_branch_menu"
                  parent="sale.product_menu_catalog"
                  action="action_pancake_branch"
                  sequence="99"/>
        <menuitem id="menu_purchase_products"
                  name="Brand"
                  parent="purchase.menu_purchase_products"
                  action="action_pancake_branch"
                  sequence="99"/>
    </data>
</odoo>